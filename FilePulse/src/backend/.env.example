APP_NAME=FilePulse
APP_ENV=development
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000

CORS_ORIGINS=http://localhost:5173

DATABASE_PATH=./data/filepulse.sqlite3
# Mock Data Source
DATA_DIR=./data

# Real clock by default. Optional DEMO_NOW override (ISO format) for reproducible demos.
# DEMO_NOW=2025-03-18T09:00:00

# AI Provider: ollama | openrouter | none (falls back to rule-based insights if none or on failure)
AI_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# Primary model for generating alert insights
OLLAMA_MODEL=qwen2.5:7b-instruct

# Fallback model if primary model is unavailable or too slow
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct

# Ollama request timeout
OLLAMA_TIMEOUT_SECONDS=30

# OpenRouter settings (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
OPENROUTER_TIMEOUT_SECONDS=30

# Generation settings
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=250
OLLAMA_NUM_CTX=2048

# Force JSON output where supported
OLLAMA_JSON_MODE=true

AI_ENABLED=true

# Pre-generate insights for top N risk-scored alerts at startup
AI_PREGENERATE=true
AI_TOP_N_ALERTS=10

# Number of recent events to send to Ollama for context
AI_MAX_RECENT_EVENTS=10
